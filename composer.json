{
  "name": "watsonhaw/lychee-php",
  "description": "A lightweight, IDE-friendly PHP web framework.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "league/flysystem": "^3.0",
    "league/flysystem-path-prefixing": "^3.0",
    "league/flysystem-read-only": "^3.0",
    "psr/log": "^3.0",
    "ramsey/uuid": "^4.0",
    "topthink/think-cache": "^3.0",
    "topthink/think-container": "^3.0",
    "topthink/think-orm": "^3.0",
    "topthink/think-validate": "^3.0",
    "twig/twig": "^3.0",
    "overtrue/flysystem-cos": "^5.0",
    "yzh52521/flysystem-oss": "^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Lychee\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyze": "phpstan --no-progress --memory-limit=1G",
    "fix-style": "php-cs-fixer fix",
    "check-style": "php-cs-fixer fix --dry-run"
  }
}
