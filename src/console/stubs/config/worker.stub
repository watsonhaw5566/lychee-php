    // 'queue' => [
    //     'connection' => null,  // 队列连接名，null 使用默认
    //     'queue'      => null,  // 队列名，null 使用默认
    //     'count'      => 1,     // 消费进程数
    //     'sleep'      => 1,     // 轮询间隔（秒）
