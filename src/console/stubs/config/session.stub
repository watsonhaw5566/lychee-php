<?php

declare(strict_types=1);

return [
    // 驱动类型
    'driver'      => 'file',

    // 会话文件存储目录，缺省为 runtime/session
    'path'        => runtime_path('session'),

    // 过期分钟数
    'expire'      => 120,

    // Cookie 名称
    'name'        => 'PHPSESSID',

    // Cookie 生效路径，缺省为 /
    'cookie_path' => '/',
];
