<?php

declare(strict_types=1);

namespace {{namespace}}\controller;

use {{namespace}}\model\{{model}};
use {{namespace}}\validate\{{model}}Validate;
use Lychee\http\JsonResponse;
use Lychee\routing\Resource;
use Lychee\routing\ResourceController;

#[Resource('{{resource}}')]
class {{class}} extends ResourceController
{
    protected string $model = {{model}}::class;

    protected string $validate = {{model}}Validate::class;

    public function index(): JsonResponse
    {
        $where = [];

        return $this->baseIndex($where);
    }

    public function save(): JsonResponse
    {
        return $this->baseSave($this->request->post());
    }

    public function read(int $id): JsonResponse
    {
        return $this->baseRead($id);
    }

    public function update(int $id): JsonResponse
    {
        return $this->baseUpdate($id, $this->request->post());
    }

    public function delete(int $id): JsonResponse
    {
        return $this->baseDelete($id);
    }

    public function batch_delete(): JsonResponse
    {
        $ids = (array) ($this->request->post()['ids'] ?? []);

        return $this->baseBatchDelete($ids);
    }
}
