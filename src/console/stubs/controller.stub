<?php

declare(strict_types=1);

namespace {{namespace}}\controller;

use {{namespace}}\model\{{model}};
use {{namespace}}\validate\{{model}}Validate;
use Lychee\http\JsonResponse;
use Lychee\http\Request;
use Lychee\routing\Resource;
use Lychee\routing\ResourceController;

#[Resource('{{resource}}')]
class {{class}} extends ResourceController
{
    protected string $modelClass = {{model}}::class;

    protected string $validateClass = {{model}}Validate::class;

    public function index(): JsonResponse
    {
        $where    = [];
        $current  = (int) $this->request->param('current', 1);
        $pageSize = (int) $this->request->param('pageSize', 20);

        return $this->baseIndex($where, $current, $pageSize);
    }

    public function save(Request $request): JsonResponse
    {
        return $this->baseSave($request);
    }

    public function read(int $id): JsonResponse
    {
        return $this->baseRead($id);
    }

    public function update(Request $request, int $id): JsonResponse
    {
        return $this->baseUpdate($request, $id);
    }

    public function delete(int $id): JsonResponse
    {
        return $this->baseDelete($id);
    }

    public function batch_delete(Request $request): JsonResponse
    {
        return $this->baseBatchDelete($request);
    }
}
